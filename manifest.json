{
  "manifest_version": 3,
  "name": "Arkan Extension",
  "version": "0.3.0",
  "description": "Fetch trainee inquiry as JSON and show it in the popup.",
  "action": {
    "default_title": "Arkan Extension",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://arkkanapp2.net/*"]
}
